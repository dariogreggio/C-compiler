STRINGTABLE PRELOAD DISCARDABLE 
BEGIN
    IDR_MAINFRAME           "OpenC"
    IDR_CTYPE               "\nSenzaTitolo\nFile C\nFile sorgenti C (*.c, *.h, *.inc)\n.c;.h;.inc\nOpenC\nDocumento sorgente C"
    IDR_CTYPE2              "\nSenzaTitolo\nFile H\nFile include C (*.h, *.inc)\n.h;.inc\nOpenC\nDocumento include C"
