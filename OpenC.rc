/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  20, 20
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    BUTTON      ID_FILE_SALVATUTTO
    BUTTON      ID_FILE_PRINT
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_COMPILA_FILE
    BUTTON      ID_COMPILA_TUTTO
    SEPARATOR
    BUTTON      ID_BUTTON32781
    SEPARATOR
    BUTTON      ID_STRUMENTI_OPZIONI
    SEPARATOR
    BUTTON      ID_APP_ABOUT
    BUTTON      ID_CONTEXT_HELP
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Nuovo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Apri...\tCtrl+A",            ID_FILE_OPEN
        MENUITEM "Nuovo progetto",              ID_FILE_NUOVOPROGETTO
        MENUITEM "Ap&ri progetto...",           ID_FILE_APRIPROGETTO
        MENUITEM "&Salva progetto",             ID_FILE_SALVAPROGETTO
        MENUITEM "Salva progetto con nome...",  ID_FILE_SALVAPROGETTOCONNOME
        MENUITEM "C&hiudi progetto",            ID_FILE_CHIUDIPROGETTO
        MENUITEM SEPARATOR
        MENUITEM "Imposta s&tampante...",       ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        POPUP "File recenti"
        BEGIN
            MENUITEM "Ultimo file usato",           ID_FILE_MRU_FILE1
            , GRAYED
        END
        POPUP "Progetti recenti"
        BEGIN
            MENUITEM "Ultimo progetto usato",       ID_PROJECT_MRU_FIRST
        END
        MENUITEM SEPARATOR
        MENUITEM "&Esci",                       ID_APP_EXIT
    END
    POPUP "&Progetto"
    BEGIN
        MENUITEM "&Progetto\tCtrl+F7",          ID_COMPILA_TUTTO
        MENUITEM "Compila tutto\tCtrl+F10",     ID_COMPILA_COMPILATUTTO
        MENUITEM SEPARATOR
        MENUITEM "&Opzioni...\tAlt+F7",         ID_STRUMENTI_OPZIONI
        MENUITEM "&Impostazioni...",            ID_COMPILA_IMPOSTAZIONI
    END
    POPUP "&Visualizza"
    BEGIN
        MENUITEM "Barra degli st&rumenti",      ID_VIEW_TOOLBAR
        MENUITEM "Barra di st&ato",             ID_VIEW_STATUS_BAR
        MENUITEM "Finestra progetto",           ID_VISUALIZZA_FINESTRAPROGETTO

        MENUITEM "Finestra di output",          ID_VISUALIZZA_FINESTRADIOUTPUT

    END
    POPUP "&?"
    BEGIN
        MENUITEM "&Argomenti della Guida",      ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "Infor&mazioni su OpenC...",   ID_APP_ABOUT
    END
END

IDR_CTYPE MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Nuovo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Apri...\tCtrl+A",            ID_FILE_OPEN
        MENUITEM "&Chiudi",                     ID_FILE_CLOSE
        MENUITEM "&Salva\tCtrl+S",              ID_FILE_SAVE
        MENUITEM "Sa&lva con nome...",          ID_FILE_SAVE_AS
        MENUITEM "Salva &tutto",                ID_FILE_SALVATUTTO
        MENUITEM SEPARATOR
        MENUITEM "Nuovo progetto",              ID_FILE_NUOVOPROGETTO
        MENUITEM "Ap&ri progetto...",           ID_FILE_APRIPROGETTO
        MENUITEM "Salva progetto",              ID_FILE_SALVAPROGETTO
        MENUITEM "Salva progetto con nome...",  ID_FILE_SALVAPROGETTOCONNOME
        MENUITEM "C&hiudi progetto",            ID_FILE_CHIUDIPROGETTO
        MENUITEM SEPARATOR
        MENUITEM "Stam&pa...\tCtrl+P",          ID_FILE_PRINT
        MENUITEM "Antepri&ma di stampa",        ID_FILE_PRINT_PREVIEW
        MENUITEM "Imposta s&tampante...",       ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        POPUP "File recenti"
        BEGIN
            MENUITEM "Ultimo file usato",           ID_FILE_MRU_FILE1
        END
        POPUP "Progetti recenti"
        BEGIN
            MENUITEM "Ultimo progetto usato",       ID_PROJECT_MRU_1, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "&Esci",                       ID_APP_EXIT
    END
    POPUP "&Modifica"
    BEGIN
        MENUITEM "&Annulla\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Tag&lia\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "&Copia\tCtrl+C",              ID_EDIT_COPY
        MENUITEM "&Incolla\tCtrl+V",            ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Trova...",                   ID_EDIT_FIND
        MENUITEM "Trova successivo\tF3",        ID_EDIT_REPEAT
        MENUITEM "C&erca selezione\tCtrl+F3",   ID_EDIT_TROVASELEZIONE
        MENUITEM "Cerca in tutti i &file...\tCtrl+Shft+F", 
                                                ID_EDIT_CERCAINTUTTIIFILE
        MENUITEM "&Sostituisci...",             ID_EDIT_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "Seleziona &tutto",            ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "Inserisci segnalibro\tCtrl+F2", 
                                                ID_MODIFICA_INSERISCISEGNALIBRO

        MENUITEM "Vai al prossimo segnalibro\tF2", 
                                                ID_MODIFICA_VAIALPROSSIMOSEGNALIBRO

        MENUITEM "Vai al segnalibro precedente\tShift+F2", 
                                                ID_MODIFICA_VAIALSEGNALIBROPRECEDENTE

    END
    POPUP "&Compila"
    BEGIN
        MENUITEM "&File corrente\tF7",          ID_COMPILA_FILE
        MENUITEM "&Progetto\tCtrl+F7",          ID_COMPILA_TUTTO
        MENUITEM "Compila tutto\tCtrl+F10",     ID_COMPILA_COMPILATUTTO
        MENUITEM SEPARATOR
        MENUITEM "&Esegui...",                  ID_COMPILA_ESEGUI
        MENUITEM SEPARATOR
        MENUITEM "&Impostazioni...",            ID_COMPILA_IMPOSTAZIONI
    END
    POPUP "&Debug"
    BEGIN
        MENUITEM "Vai",                         ID_DEBUG_VAI
        MENUITEM "Vai dentro funzione",         ID_DEBUG_VAIDENTROFUNZIONE
        MENUITEM "Esci da funzione",            ID_DEBUG_ESCIDAFUNZIONE
        MENUITEM "Interrompi",                  ID_DEBUG_INTERROMPI
        MENUITEM "Termina esecuzione",          ID_DEBUG_TERMINAESECUZIONE
        MENUITEM SEPARATOR
        MENUITEM "Toggle breakpoint",           ID_DEBUG_TOGGLEBREAKPOINT
    END
    POPUP "&Strumenti"
    BEGIN
        MENUITEM "&Opzioni...\tAlt+F7",         ID_STRUMENTI_OPZIONI
        MENUITEM "&Personalizza...",            ID_STRUMENTI_PERSONALIZZA
        MENUITEM SEPARATOR
        MENUITEM "&Spy...",                     ID_STRUMENTI_SPY
    END
    POPUP "&Visualizza"
    BEGIN
        MENUITEM "Barra degli st&rumenti",      ID_VIEW_TOOLBAR
        MENUITEM "Barra di st&ato",             ID_VIEW_STATUS_BAR
        MENUITEM "Finestra progetto",           ID_VISUALIZZA_FINESTRAPROGETTO

        MENUITEM "Finestra di output",          ID_VISUALIZZA_FINESTRADIOUTPUT

    END
    POPUP "Fi&nestra"
    BEGIN
        MENUITEM "&Sovrapponi",                 ID_WINDOW_CASCADE
        MENUITEM "&Affianca",                   ID_WINDOW_TILE_HORZ
        MENUITEM "Di&vidi",                     ID_WINDOW_SPLIT
        MENUITEM "&Chiudi tutte",               ID_FINESTRA_CHIUDITUTTE
    END
    POPUP "&?"
    BEGIN
        MENUITEM "&Argomenti della Guida",      ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "Infor&mazioni su OpenC...",   ID_APP_ABOUT
    END
END


