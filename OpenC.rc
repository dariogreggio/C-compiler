//
// Menu
//

IDR_PROJECTTREE MENU DISCARDABLE 
BEGIN
    POPUP "tree"
    BEGIN
        MENUITEM "Compila",                     ID_COMPILA_FILE
        MENUITEM "Apri",                        ID_TREE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Impostazioni",                ID_TREE_IMPOSTAZIONI
        MENUITEM "Escludi",                     ID_TREE_ESCLUDI
        MENUITEM "Elimina",                     ID_TREE_ELIMINA
        MENUITEM SEPARATOR
        MENUITEM "Proprietà",                   ID_TREE_PROPRIET
    END
END

IDR_PROJECTTREE1 MENU DISCARDABLE 
BEGIN
    POPUP "tree1"
    BEGIN
        MENUITEM "Aggiungi file...",            ID_TREE_ADD
        MENUITEM SEPARATOR
        MENUITEM "Proprietà",                   ID_TREE_PROPRIET
    END
END


